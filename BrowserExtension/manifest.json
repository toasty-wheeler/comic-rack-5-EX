{
  "manifest_version": 3,
  "name": "ComicRack Downloader",
  "version": "1.0.0",
  "description": "Downloads the comic on the current page into ComicRack Community Edition, with its metadata. Made for Microsoft Edge.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "declarativeNetRequest", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ComicRack Downloader",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
